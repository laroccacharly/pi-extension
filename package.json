{
  "name": "pi-extension",
  "version": "0.1.0",
  "private": false,
  "description": "Pi extensions: OpenRouter spend and routing, Codex and OpenRouter fast mode, and a Venice provider.",
  "keywords": [
    "codex",
    "extension",
    "openrouter",
    "pi",
    "pi-package",
    "venice"
  ],
  "license": "MIT",
  "author": "laroccacharly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laroccacharly/pi-extension.git"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test e2e/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "26.0.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7",
    "typescript": "7.0.2",
    "ultracite": "7.11.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts"
    ]
  }
}
